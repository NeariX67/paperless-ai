<!-- views/documents.ejs -->
<!DOCTYPE html>
<html lang="en" class="h-full" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Documents - Paperless-AI</title>
    <script src="https://cdn.tailwindcss.com/3.4.16"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.css">
    <link rel="stylesheet" href="css/dashboard.css">
    <style>
        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter {
            margin-bottom: 1rem;
        }
        .dataTables_wrapper .dataTables_info,
        .dataTables_wrapper .dataTables_paginate {
            margin-top: 1rem;
        }
        .modal {
            transition: opacity 0.3s ease-in-out;
            opacity: 0;
            pointer-events: none;
        }
        .modal.show {
            opacity: 1;
            pointer-events: auto;
        }
        .modal.hidden {
            display: none;
        }
        tr.row-selected td {
            background-color: rgba(59, 130, 246, 0.08);
        }
        .tag-chip {
            display: inline-block;
            padding: 0.125rem 0.5rem;
            margin: 0.125rem 0.125rem 0.125rem 0;
            border-radius: 9999px;
            font-size: 0.75rem;
            white-space: nowrap;
        }
        /* Tom Select in the app's theme (light and dark) */
        .ts-wrapper .ts-control,
        .ts-dropdown {
            background: var(--bg-primary);
            color: var(--text-primary);
            border-color: var(--border-color);
        }
        .ts-wrapper .ts-control input {
            color: var(--text-primary);
        }
        .ts-dropdown .option.active {
            background: var(--hover-bg);
            color: var(--text-primary);
        }
        .ts-wrapper.multi .ts-control > .item {
            background: var(--stats-box-highlight);
            color: var(--text-primary);
            border-radius: 9999px;
        }
        [data-theme="dark"] #runBanner.bg-blue-50 { background: #172554; color: #dbeafe; border-color: #1e40af; }
        [data-theme="dark"] #runBanner.bg-green-50 { background: #052e16; color: #dcfce7; border-color: #166534; }
        [data-theme="dark"] #runBanner.bg-red-50 { background: #450a0a; color: #fee2e2; border-color: #991b1b; }
        .selection-bar {
            position: sticky;
            top: 0;
            z-index: 5;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
        }
    </style>
</head>
<body class="h-full">
    <button id="themeToggle" class="theme-toggle">
        <i class="fas fa-moon dark:fas fa-sun"></i>
    </button>

    <div class="layout-container">
        <button id="mobileMenuButton" class="mobile-menu-button">
            <i class="fas fa-bars"></i>
        </button>
        <!-- Sidebar -->
        <div id="sidebarOverlay" class="sidebar-overlay"></div>
        <aside class="sidebar">
            <div class="sidebar-header">
                <img src="/favicon.ico" class="no-invert" alt="Paperless AI Logo" style="height: 60px;">
                <h1 class="brand-title">Paperless-AI<small style="display: block;"><%= version %></small></h1>
            </div>

            <nav class="sidebar-nav">
                <ul>
                    <li><a href="/dashboard" class="sidebar-link"><i class="fas fa-home"></i><span>Dashboard</span></a></li>
                    <li><a href="/manual" class="sidebar-link"><i class="fas fa-file-alt"></i><span>Manual</span></a></li>
                    <li><a href="/chat" class="sidebar-link"><i class="fa-solid fa-comment"></i><span>Chat</span></a></li>
                    <li><a href="/rag" class="sidebar-link"><i class="fa-solid fa-comment"></i><span>RAG Chat</span></a></li>
                    <li><a href="/playground" class="sidebar-link"><i class="fa-solid fa-flask-vial"></i><span>Playground</span></a></li>
                    <li><a href="/history" class="sidebar-link"><i class="fa-solid fa-clock-rotate-left"></i><span>History</span></a></li>
                    <li><a href="/documents" class="sidebar-link active"><i class="fa-solid fa-folder-open"></i><span>Documents</span></a></li>
                    <li><a href="/settings" class="sidebar-link"><i class="fas fa-cog"></i><span>Settings</span></a></li>
                    <li><a href="/logout" class="sidebar-link"><i class="fa-solid fa-right-from-bracket"></i><span>Logout</span></a></li>
                </ul>
                <a href="https://github.com/clusterzx/paperless-ai"
                class="github-button"
                style="position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%);">
                <span class="star-button">
                    <svg class="star-icon" height="16" width="16" viewBox="0 0 16 16">
                        <path d="M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.72-4.194L.818 6.374a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25z"></path>
                    </svg>
                    Star
                </span>
                <span id="starCount" class="star-count">1.2k</span>
            </a>
            <p style="position: absolute; bottom: 50px; left: 50%; transform: translateX(-50%); font-size: 10px; color: #555; text-align: center;">
                Please support us on GitHub
            </p>
            </nav>
        </aside>

        <main class="main-content">
            <div class="content-wrapper">
                <div class="content-header flex justify-between items-center mb-6">
                    <h1 class="content-title">Documents</h1>
                </div>

                <!-- Filters -->
                <div class="flex flex-wrap items-end gap-4 mb-4">
                    <div class="flex-1 min-w-[240px]">
                        <label for="tagFilter" class="block text-sm font-medium mb-1">Tags</label>
                        <select id="tagFilter" multiple placeholder="Any tag">
                            <% filters.tags.forEach(function(tag) { %>
                                <option value="<%= tag.id %>"><%= tag.name %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div>
                        <label for="tagMode" class="block text-sm font-medium mb-1">Match</label>
                        <select id="tagMode" class="px-3 py-2 border rounded-lg">
                            <option value="any">Any of these tags</option>
                            <option value="all">All of these tags</option>
                        </select>
                    </div>
                    <div class="flex-1 min-w-[240px]">
                        <label for="correspondentFilter" class="block text-sm font-medium mb-1">Correspondents</label>
                        <select id="correspondentFilter" multiple placeholder="Any correspondent">
                            <% filters.correspondents.forEach(function(corr) { %>
                                <option value="<%= corr.id %>"><%= corr.name %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div>
                        <label for="processedFilter" class="block text-sm font-medium mb-1">Paperless-AI</label>
                        <select id="processedFilter" class="px-3 py-2 border rounded-lg">
                            <option value="any">All documents</option>
                            <option value="unprocessed">Not processed</option>
                            <option value="processed">Processed</option>
                        </select>
                    </div>
                    <button id="clearFilters" class="px-3 py-2 border rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">
                        Clear filters
                    </button>
                </div>

                <!-- Run progress (reprocess / scan) -->
                <div id="runBanner" class="hidden mb-4 px-4 py-3 rounded-lg border border-blue-300 bg-blue-50 text-blue-900 text-sm">
                    <i id="runBannerIcon" class="fas fa-spinner fa-spin mr-2"></i>
                    <span id="runBannerText"></span>
                </div>

                <!-- Selection and actions -->
                <div class="selection-bar flex flex-wrap items-center gap-3 mb-4 px-4 py-3 rounded-lg">
                    <span id="selectionCount" class="text-sm font-medium">No documents selected</span>
                    <span id="selectAllMatchingHint" class="hidden text-sm">
                        <span id="pageSelectedText"></span>
                        <button id="selectAllMatching" class="text-blue-600 hover:underline"></button>
                    </span>
                    <div class="flex gap-2 ml-auto">
                        <button id="reprocessSelected" class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                            <i class="fas fa-redo mr-1"></i> Reprocess
                        </button>
                        <button id="clearSelection" class="px-4 py-2 border rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 disabled:opacity-50" disabled>
                            Clear selection
                        </button>
                    </div>
                </div>

                <div class="material-card">
                    <div class="overflow-x-auto">
                        <table id="documentsTable" class="w-full">
                            <thead>
                                <tr>
                                    <th><input type="checkbox" id="selectPage" class="rounded" title="Select all on this page"></th>
                                    <th>ID</th>
                                    <th>Title</th>
                                    <th>Tags</th>
                                    <th>Correspondent</th>
                                    <th>Created</th>
                                    <th title="When Paperless-AI last processed the document">Paperless-AI</th>
                                    <th></th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Reprocess confirmation -->
    <div id="reprocessModal" class="modal hidden">
        <div class="modal-overlay"></div>
        <div class="modal-container">
            <div class="modal-header">
                <h3 class="modal-title">Reprocess documents</h3>
                <button class="modal-close"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-content">
                <p class="mb-3">
                    <span id="reprocessCountText"></span> will be analysed again with the current provider chain and prompt.
                    Choose what to update in Paperless-ngx:
                </p>
                <div class="flex flex-col gap-2 mb-3">
                    <% reprocessFields.forEach(function(field) { %>
                        <label class="flex items-center gap-2 text-sm">
                            <input type="checkbox" class="reprocess-field" value="<%= field %>" checked>
                            <span><%= field.charAt(0).toUpperCase() + field.slice(1) %></span>
                        </label>
                    <% }); %>
                </div>
                <p class="mb-4 text-sm text-gray-600">
                    Tags added by the previous Paperless-AI run are replaced by the new ones; original tags and tags you
                    added yourself stay. A new correspondent replaces the current one. Date, document type and custom
                    fields are not changed. Restore earlier values from the History page.
                </p>
                <p id="reprocessError" class="hidden mb-3 text-sm text-red-600"></p>
                <div class="flex justify-end gap-4">
                    <button id="cancelReprocess" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-100">Cancel</button>
                    <button id="confirmReprocess" class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 disabled:opacity-50">Start reprocess</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const mobileMenuButton = document.getElementById('mobileMenuButton');
            const sidebar = document.querySelector('.sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');

            function toggleSidebar(event) {
                event.stopPropagation();
                sidebar.classList.toggle('active');
                sidebarOverlay.classList.toggle('active');
                const icon = mobileMenuButton.querySelector('i');
                icon.classList.toggle('fa-bars', !sidebar.classList.contains('active'));
                icon.classList.toggle('fa-times', sidebar.classList.contains('active'));
            }

            mobileMenuButton.addEventListener('click', toggleSidebar);
            sidebarOverlay.addEventListener('click', function(event) {
                event.stopPropagation();
                if (sidebar.classList.contains('active')) toggleSidebar(event);
            });
            sidebar.addEventListener('click', function(event) {
                event.stopPropagation();
            });
        });

        // get github stars count from repo
        async function getStarsCount() {
            try {
                const response = await fetch('https://api.github.com/repos/clusterzx/paperless-ai');
                if (!response.ok) throw new Error('Failed to fetch repo info');
                const data = await response.json();
                document.getElementById('starCount').textContent = data.stargazers_count.toLocaleString();
            } catch (error) {
                console.error('Failed to fetch stars count:', error);
            }
        }
        document.addEventListener('DOMContentLoaded', getStarsCount);
    </script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script src="js/documents.js"></script>
</body>
</html>
